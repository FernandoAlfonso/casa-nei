<IfModule mod_rewrite.c>
    RewriteEngine On
    # Asumiendo que el sitio se sirve bajo la carpeta /casa-nei/
    RewriteBase /casa-nei/

    # Si la URL empieza por descarga/, redirigir internamente a descarga.html
    # Ejemplo: /casa-nei/descarga/tres-dan-tian -> descarga.html
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^descarga/([a-zA-Z0-9-]+)/?$ descarga.html?doc=$1 [L,QSA]
</IfModule>

# ----------------------------------------------------------------------
# Compresión Gzip / Deflate para acelerar carga en conexiones móviles
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript text/javascript application/json image/svg+xml
</IfModule>

# ----------------------------------------------------------------------
# Control de Caché y Revalidación para Dispositivos Móviles y PWA
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
    # 1. Archivos HTML: Siempre revalidar para que el usuario reciba los últimos enlaces (?v=),
    # omitiendo no-store para conservar el Back-Forward Cache (bfcache) al volver desde WhatsApp
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-cache, max-age=0, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </FilesMatch>

    # 2. Archivos CSS y JavaScript: Revalidación condicional (ETag / 304 Not Modified)
    # combinada con versionado ?v=HASH en HTML y en declaraciones import de ES Modules
    <FilesMatch "\.(css|js|mjs)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# Habilitar ETag basado en tiempo de modificación y tamaño de archivo
FileETag MTime Size

